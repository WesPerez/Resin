RESIN_ADMIN_TOKEN=change-me-admin-token
# Set RESIN_PROXY_TOKEN= to disable proxy authentication.
RESIN_PROXY_TOKEN=change-me-proxy-token
RESIN_PORT=2260
# Optional bounded recovery for HTTP CONNECT and SOCKS5 tunnels.
RESIN_PROXY_CONNECT_TIMEOUT=0s
RESIN_PROXY_CONNECT_RETRIES=0
RESIN_PROXY_TUNNEL_FIRST_BYTE_TIMEOUT=0s
