# Optional non-secret overrides for the fixed-port sing-box bridge refresh.
BRIDGE_SOURCE_URL="https://raw.githubusercontent.com/0xRadikal/Free-v2ray-Configs/main/verified/singbox.json"
BRIDGE_TARGET_HOSTS="www.cloudflare.com www.microsoft.com www.wikipedia.org"
BRIDGE_MIN_TARGET_HOSTS_PASSED=2
BRIDGE_TARGET_NODES=1000
BRIDGE_MAX_GENERATION_AGE_HOURS=24
BRIDGE_CANDIDATE_LIMIT=0
BRIDGE_MAX_PER_CREDENTIAL_GROUP=0
BRIDGE_RETAIN_GENERATIONS=1
BRIDGE_DNS_WORKERS=16
BRIDGE_PROBE_WORKERS=32
BRIDGE_PROBE_BATCH_SIZE=64
BRIDGE_PROBE_BASE_PORT=20000
BRIDGE_PUBLISH_LISTEN=172.17.0.1
BRIDGE_PUBLISH_BASE_PORT=12000
BRIDGE_DIRECT_PORT=12400
BRIDGE_DIRECT_USERNAME=sub2-direct
# Enable optional public Gist/URI sources after installing the local converter.
# BRIDGE_DISCOVERY_CONFIG=/etc/server-scheduled-tasks/resin-discovery.json
# BRIDGE_SUBSCRIPTION_CONVERTER=/opt/resin-subscription-converter/bin/subscription-converter
# Stable HAProxy front end; use restart only for an explicit legacy rollback.
BRIDGE_SWITCH_MODE=graceful
