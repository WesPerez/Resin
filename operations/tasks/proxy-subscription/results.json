{
  "proxy-client-health.timer": {
    "file": "client-health.json",
    "summary": "服务端经公网入口的真实客户端验证",
    "metrics": [
      {
        "path": "status",
        "label": "本轮检查",
        "labels": {
          "ok": "全部通过",
          "failed": "链路检查失败",
          "deferred": "等待合格的站点专用出口",
          "skipped": "出口变化，等待下次复验"
        }
      },
      {
        "path": "ok",
        "label": "整体验证",
        "labels": {
          "true": "通过",
          "false": "未通过"
        }
      },
      {
        "path": "subscription.passed",
        "label": "订阅一致性",
        "labels": {
          "true": "通过",
          "false": "未通过"
        }
      },
      {
        "path": "general.passed",
        "label": "通用出口",
        "labels": {
          "true": "通过",
          "false": "未通过"
        }
      },
      {
        "path": "strict.passed",
        "label": "站点专用出口",
        "labels": {
          "true": "通过",
          "false": "未通过"
        }
      },
      {
        "path": "strict_approved_count",
        "label": "已验证专用出口",
        "unit": "个"
      },
      {
        "path": "strict.reason",
        "label": "专用出口说明",
        "labels": {
          "strict_pool_empty": "暂无通过站点验证的出口，专用通道保持关闭"
        }
      }
    ],
    "root": "proxy",
    "at": "finished_at",
    "warnings": [
      {
        "path": "status",
        "equals": "failed",
        "message": "客户端链路验收未通过，请检查订阅与出口状态。"
      },
      {
        "path": "strict.reason",
        "equals": "strict_pool_empty",
        "message": "站点专用出口暂不可用，等待节点通过站点验证。"
      },
      {
        "path": "inconclusive",
        "equals": true,
        "message": "采样期间出口发生变化，本次结果需要复验。"
      }
    ],
    "status_map": {
      "deferred": "deferred",
      "skipped": "skipped"
    }
  },
  "proxy-rotation-quality.timer": {
    "source": "journal",
    "at": "_reported_at",
    "summary": "共享出口最近一轮验证与发布",
    "metrics": [
      {
        "path": "mode",
        "label": "出口策略",
        "labels": {
          "unified": "统一站点验证",
          "balanced": "分层出口"
        }
      },
      {
        "path": "site_qualified",
        "label": "通过站点验证的出口",
        "unit": "个"
      },
      {
        "path": "published",
        "label": "已发布出口",
        "unit": "个"
      },
      {
        "path": "approved",
        "label": "合格出口",
        "unit": "个"
      },
      {
        "path": "status",
        "label": "处理结果",
        "labels": {
          "ok": "完成",
          "planned": "仅检查，未改动",
          "skipped": "本次跳过",
          "error": "失败",
          "strict": "已按验证资格收口",
          "success": "完成"
        }
      },
      {
        "path": "reason",
        "label": "跳过原因",
        "labels": {
          "pool maintenance active or queued": "代理池维护正在运行，等待下一次计划",
          "shared pool owns browser validation": "共享代理池已统一负责浏览器验证",
          "no configured candidates": "暂无已配置候选"
        }
      }
    ],
    "match_any": [
      "site_qualified",
      "published",
      "approved",
      "status"
    ],
    "status_map": {
      "skipped": "skipped"
    },
    "warnings": [
      {
        "path": "site_qualified",
        "equals": 0,
        "message": "暂无通过站点验证的出口；通用出口仍可独立使用。"
      }
    ]
  },
  "proxy-region-latency.timer": {
    "source": "journal",
    "at": "_reported_at",
    "summary": "区域出口最新资格检查",
    "metrics": [
      {
        "path": "status",
        "label": "处理结果",
        "labels": {
          "ok": "完成",
          "planned": "仅检查，未改动",
          "skipped": "本次跳过",
          "error": "失败",
          "strict": "已按验证资格收口",
          "success": "完成"
        }
      },
      {
        "path": "reason",
        "label": "跳过原因",
        "labels": {
          "pool maintenance active or queued": "代理池维护正在运行，等待下一次计划",
          "shared pool owns browser validation": "共享代理池已统一负责浏览器验证",
          "no configured candidates": "暂无已配置候选"
        }
      },
      {
        "path": "approved_regions",
        "label": "合格区域",
        "op": "count",
        "unit": "个"
      },
      {
        "path": "rotation_exits",
        "label": "共享合格出口",
        "unit": "个"
      },
      {
        "path": "updated",
        "label": "更新项",
        "op": "count",
        "unit": "项"
      }
    ],
    "match_any": [
      "status",
      "approved_regions"
    ],
    "status_map": {
      "skipped": "skipped"
    }
  }
}
