{
  "proxy-rotation-quality.timer": {
    "file": "proxy-subscription-settings.json",
    "format": "json",
    "title": "共享出口验证",
    "description": "共同维护代理池资格、浏览器验证有效期和故障冷却。",
    "fields": [
      {
        "key": "rotation_batch_size",
        "label": "每轮最多验证出口数",
        "type": "integer",
        "default": 8,
        "min": 1,
        "max": 8,
        "unit": "个",
        "section": "常用参数",
        "help": "降低可减少每轮开销，也会延长候选轮转时间。"
      },
      {
        "key": "site_ttl_minutes",
        "label": "站点验证有效期",
        "type": "integer",
        "default": 90,
        "min": 45,
        "max": 90,
        "unit": "分钟",
        "section": "常用参数",
        "help": "缩短后会更早撤下过期出口，必须等待再次验证通过。"
      },
      {
        "key": "rotation_ttl_minutes",
        "label": "路由资格有效期",
        "type": "integer",
        "default": 60,
        "min": 30,
        "max": 60,
        "unit": "分钟",
        "section": "常用参数",
        "help": ""
      },
      {
        "key": "max_page_load_ms",
        "label": "页面加载耗时上限",
        "type": "integer",
        "default": 18000,
        "min": 3000,
        "max": 18000,
        "unit": "毫秒",
        "section": "常用参数",
        "help": "更严格的上限可能减少通过验证的出口。"
      },
      {
        "key": "network_cooldown_minutes",
        "label": "网络故障冷却时间",
        "type": "integer",
        "default": 30,
        "min": 30,
        "max": 120,
        "unit": "分钟",
        "section": "失败与重试",
        "help": ""
      },
      {
        "key": "challenge_quarantine_hours",
        "label": "验证码出口隔离时间",
        "type": "integer",
        "default": 24,
        "min": 24,
        "max": 168,
        "unit": "小时",
        "section": "失败与重试",
        "help": ""
      }
    ],
    "optional_file": true,
    "effect": "各任务下一次启动时读取，正在进行的检查使用启动时配置。",
    "shared_scope": [
      "共享出口更新",
      "站点访问复查",
      "区域资格维护"
    ],
    "notes": [
      "现有订阅模式、地区/出口身份、两站检查要求和凭据保持由原策略维护。"
    ]
  },
