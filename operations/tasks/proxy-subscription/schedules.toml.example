version = 1
repo_root = "/root/server-scheduled-tasks"

[[units]]
name = "proxy-rotation-quality.timer"
source = "tasks/proxy-subscription/systemd/proxy-rotation-quality.timer"
enabled = true
on_boot_sec = ["8min"]
on_unit_inactive_sec = ["3min"]
accuracy_sec = "1min"
randomized_delay_sec = "15s"
fixed_random_delay = false
persistent = false
