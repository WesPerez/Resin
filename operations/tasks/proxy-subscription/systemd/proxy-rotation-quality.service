[Unit]
Description=Recheck shared subscription exits through both websites
After=network-online.target resin-apps.service

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/resin-operations/operations/tasks/proxy-subscription/rotation-control.py refresh --wait-seconds 30
ExecStopPost=/usr/bin/python3 /opt/resin-operations/operations/tasks/proxy-subscription/rotation-control.py enforce --wait-seconds 30
ExecStopPost=/usr/bin/python3 /opt/resin-operations/operations/tasks/proxy-subscription/site-control.py enforce --render --wait-seconds 30
TimeoutStartSec=30min
TimeoutStopSec=90s
UMask=0077
Nice=15
StateDirectory=proxy-region-latency
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/lock /var/lib/proxy-subscription /var/lib/proxy-site-browser
InaccessiblePaths=/root/.ssh /root/.codex /etc/server-scheduled-tasks
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL
MemoryMax=1200M
CPUQuota=100%
CPUWeight=20
