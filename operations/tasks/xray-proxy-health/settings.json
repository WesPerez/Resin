{
  "xray-proxy-health.timer": {
    "file": "xray-proxy-health.env",
    "format": "env",
    "title": "代理入口监测阈值",
    "description": "按 HTTP 质量、连接资源和主机网络分组调整告警敏感度。",
    "effect": "下一次入口监测时读取；不影响代理服务当前连接。",
    "fields": [
      {
        "key": "WS_TOTAL_MIN",
        "label": "WebSocket 最少样本数",
        "type": "integer",
        "default": 20,
        "min": 1,
        "max": 10000,
        "unit": "次",
        "scale": 1,
        "section": "HTTP 质量",
        "help": ""
      },
      {
        "key": "WS_503_RATIO_WARN_PCT",
        "label": "WebSocket 503 告警比例",
        "type": "integer",
        "default": 50,
        "min": 1,
        "max": 100,
        "unit": "%",
        "scale": 1,
        "section": "HTTP 质量",
        "help": ""
      },
      {
        "key": "WS_503_COUNT_WARN",
        "label": "WebSocket 503 告警次数",
        "type": "integer",
        "default": 100,
        "min": 1,
        "max": 100000,
        "unit": "次",
        "scale": 1,
        "section": "HTTP 质量",
        "help": ""
      },
      {
        "key": "WS_SHORT_MIN",
        "label": "短连接最少样本数",
        "type": "integer",
        "default": 20,
        "min": 1,
        "max": 10000,
        "unit": "次",
        "scale": 1,
        "section": "HTTP 质量",
        "help": ""
      },
      {
        "key": "WS_SHORT_RATIO_WARN_PCT",
        "label": "短连接告警比例",
        "type": "integer",
        "default": 50,
        "min": 1,
        "max": 100,
        "unit": "%",
        "scale": 1,
        "section": "HTTP 质量",
        "help": ""
      },
      {
        "key": "XHTTP_TOTAL_MIN",
        "label": "XHTTP 最少样本数",
        "type": "integer",
        "default": 2,
        "min": 1,
        "max": 10000,
        "unit": "次",
        "scale": 1,
        "section": "HTTP 质量",
        "help": ""
      },
      {
        "key": "XHTTP_BAD_RATIO_WARN_PCT",
        "label": "XHTTP 异常告警比例",
        "type": "integer",
        "default": 50,
        "min": 1,
        "max": 100,
        "unit": "%",
        "scale": 1,
        "section": "HTTP 质量",
        "help": ""
      },
      {
        "key": "XHTTP_BAD_COUNT_WARN",
        "label": "XHTTP 异常告警次数",
        "type": "integer",
        "default": 5,
        "min": 1,
        "max": 100000,
        "unit": "次",
        "scale": 1,
        "section": "HTTP 质量",
        "help": ""
      },
      {
        "key": "CONN_443_WARN",
        "label": "HTTPS 连接告警数量",
        "type": "integer",
        "default": 600,
        "min": 1,
        "max": 100000,
        "unit": "条",
        "scale": 1,
        "section": "连接与内存",
        "help": ""
      },
      {
        "key": "CONN_BACKEND_WARN",
        "label": "后端连接告警数量",
        "type": "integer",
        "default": 600,
        "min": 1,
        "max": 100000,
        "unit": "条",
        "scale": 1,
        "section": "连接与内存",
        "help": ""
      },
      {
        "key": "MAX_PEER_443_WARN",
        "label": "单客户端 HTTPS 连接上限",
        "type": "integer",
        "default": 300,
        "min": 1,
        "max": 100000,
        "unit": "条",
        "scale": 1,
        "section": "连接与内存",
        "help": ""
      },
      {
        "key": "PRE_WS_GAP_WARN",
        "label": "握手前连接差值告警",
        "type": "integer",
        "default": 200,
        "min": 1,
        "max": 100000,
        "unit": "条",
        "scale": 1,
        "section": "连接与内存",
        "help": ""
      },
      {
        "key": "PRE_WS_MAX_PEER_WARN",
        "label": "单客户端握手前连接告警",
        "type": "integer",
        "default": 200,
        "min": 1,
        "max": 100000,
        "unit": "条",
        "scale": 1,
        "section": "连接与内存",
        "help": ""
      },
      {
        "key": "MEM_AVAILABLE_WARN_MB",
        "label": "可用内存告警线",
        "type": "integer",
        "default": 200,
        "min": 64,
        "max": 65536,
        "unit": "MiB",
        "scale": 1,
        "section": "连接与内存",
        "help": ""
      },
      {
        "key": "SWAP_USED_WARN_MB",
        "label": "交换空间占用告警线",
        "type": "integer",
        "default": 3000,
        "min": 0,
        "max": 65536,
        "unit": "MiB",
        "scale": 1,
        "section": "连接与内存",
        "help": ""
      },
      {
        "key": "TCP_RETRANS_DELTA_WARN",
        "label": "TCP 重传增量告警",
        "type": "integer",
        "default": 1000,
        "min": 1,
        "max": 1000000,
        "unit": "次",
        "scale": 1,
        "section": "主机网络与提醒",
        "help": ""
      },
      {
        "key": "TCP_SYNRETRANS_DELTA_WARN",
        "label": "SYN 重传增量告警",
        "type": "integer",
        "default": 100,
        "min": 1,
        "max": 1000000,
        "unit": "次",
        "scale": 1,
        "section": "主机网络与提醒",
        "help": ""
      },
      {
        "key": "TCP_TIMEOUT_DELTA_WARN",
        "label": "TCP 超时增量告警",
        "type": "integer",
        "default": 100,
        "min": 1,
        "max": 1000000,
        "unit": "次",
        "scale": 1,
        "section": "主机网络与提醒",
        "help": ""
      },
      {
        "key": "TCP_LISTEN_DROP_DELTA_WARN",
        "label": "监听队列丢弃增量告警",
        "type": "integer",
        "default": 1,
        "min": 1,
        "max": 1000000,
        "unit": "次",
        "scale": 1,
        "section": "主机网络与提醒",
        "help": ""
      },
      {
        "key": "TCP_BACKLOG_DROP_DELTA_WARN",
        "label": "接收队列丢弃增量告警",
        "type": "integer",
        "default": 1,
        "min": 1,
        "max": 1000000,
        "unit": "次",
        "scale": 1,
        "section": "主机网络与提醒",
        "help": ""
      },
      {
        "key": "ALERT_COOLDOWN_SEC",
        "label": "重复告警间隔",
        "type": "integer",
        "default": 600,
        "min": 60,
        "max": 86400,
        "unit": "秒",
        "scale": 1,
        "section": "主机网络与提醒",
        "help": ""
      }
    ],
    "notes": [
      "主机级 TCP 计数用于辅助判断，不代表全部由代理产生。",
      "端口、日志位置、服务器地址与凭据沿用已部署配置。"
    ]
  }
}
