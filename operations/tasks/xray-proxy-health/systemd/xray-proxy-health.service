[Unit]
Description=Minute-level Xray proxy health sample
After=network-online.target nginx.service xray-proxy.service
Wants=network-online.target

[Service]
Type=oneshot
SupplementaryGroups=adm
EnvironmentFile=-/etc/server-scheduled-tasks/xray-proxy-health.env
ExecStart=/opt/resin-operations/operations/tasks/xray-proxy-health/xray-proxy-health.sh
TimeoutStartSec=45
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
ReadWritePaths=/var/lib/server-scheduled-tasks/xray-proxy-health /var/log/xray-proxy-health /run/lock
