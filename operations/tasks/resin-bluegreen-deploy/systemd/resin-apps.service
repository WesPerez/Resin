[Unit]
Description=Resin blue/green proxy slots
After=network-online.target resin-singbox-bridge.service docker.service
Wants=network-online.target resin-singbox-bridge.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/resin-operations/operations/tasks/resin-bluegreen-deploy/resin-bluegreen-deploy.sh start
ExecReload=/opt/resin-operations/operations/tasks/resin-bluegreen-deploy/resin-bluegreen-deploy.sh reconcile
ExecStop=/bin/true
TimeoutStartSec=120
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/resin-operations /etc/resin-apps
ReadWritePaths=/var/lib/resin-slots /run/lock
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# ss -p verifies the legacy listener during first-migration recovery.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_OVERRIDE
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
